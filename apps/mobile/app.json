{
  "expo": {
    "name": "مصحف تميمي",
    "slug": "tamimi-mushaf",
    "version": "1.0.0",
    "description": "مصحف رقمي للقراءة دون اتصال",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tamimimushaf",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.mohamedtamemi.tamimimushaf",
      "supportsTablet": true
    },
    "android": {
      "package": "com.mohamedtamemi.tamimimushaf",
      "adaptiveIcon": {
        "backgroundColor": "#627536",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "name": "مصحف تميمي",
      "shortName": "مصحف",
      "description": "مصحف رقمي للقراءة دون اتصال",
      "themeColor": "#627536",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "Cross-Origin-Embedder-Policy": "credentialless",
            "Cross-Origin-Opener-Policy": "same-origin"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F6F2E6"
        }
      ],
      "expo-sqlite",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "enableRemoteNotifications": false,
          "defaultChannel": "daily-reading",
          "color": "#627536"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      }
    }
  }
}
